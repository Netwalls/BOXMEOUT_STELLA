{
  "openapi": "3.0.3",
  "info": {
    "title": "BOXMEOUT API",
    "version": "0.1.0",
    "description": "REST API for the BOXMEOUT decentralized boxing prediction market on Stellar."
  },
  "servers": [
    { "url": "http://localhost:3001", "description": "Local dev" }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Markets" },
    { "name": "Bets" },
    { "name": "Oracle" },
    { "name": "Admin" },
    { "name": "Auth" },
    { "name": "Users" },
    { "name": "Search" },
    { "name": "Stats" }
  ],
  "components": {
    "securitySchemes": {
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "ADMIN_API_KEY — required for /api/admin/* routes"
      },
      "OracleBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "ORACLE_API_KEY — required for POST /api/oracle/submit"
      },
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "JWT — required for authenticated /api/users/* routes"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "example": "Market not found" },
          "code": { "type": "string", "example": "NOT_FOUND" }
        }
      },
      "Fighter": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Canelo Alvarez" },
          "record": { "type": "string", "example": "60-2-2" },
          "nationality": { "type": "string", "example": "Mexico" },
          "weightClass": { "type": "string", "example": "Super Middleweight" }
        }
      },
      "Market": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "abc123" },
          "contractAddress": { "type": "string", "example": "CABC..." },
          "fighterA": { "$ref": "#/components/schemas/Fighter" },
          "fighterB": { "$ref": "#/components/schemas/Fighter" },
          "scheduledAt": { "type": "string", "format": "date-time" },
          "bettingEndsAt": { "type": "string", "format": "date-time" },
          "status": {
            "type": "string",
            "enum": ["Open", "Locked", "Resolved", "Cancelled", "Disputed"]
          },
          "outcome": { "type": "string", "nullable": true, "example": null },
          "poolA": { "type": "string", "example": "500000000" },
          "poolB": { "type": "string", "example": "300000000" },
          "totalPool": { "type": "string", "example": "800000000" },
          "oracleAddress": { "type": "string", "example": "GABC..." },
          "createdBy": { "type": "string", "example": "GABC..." }
        }
      },
      "MarketStats": {
        "type": "object",
        "properties": {
          "totalBets": { "type": "integer", "example": 142 },
          "uniqueBettors": { "type": "integer", "example": 89 },
          "poolA": { "type": "string", "example": "500000000" },
          "poolB": { "type": "string", "example": "300000000" },
          "totalVolume": { "type": "string", "example": "800000000" },
          "impliedOddsA": { "type": "number", "example": 62.5 },
          "impliedOddsB": { "type": "number", "example": 37.5 }
        }
      },
      "Bet": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "bet_xyz" },
          "marketId": { "type": "string", "example": "abc123" },
          "bettor": { "type": "string", "example": "GABC..." },
          "side": { "type": "string", "enum": ["FighterA", "FighterB"] },
          "amount": { "type": "string", "example": "10000000" },
          "placedAt": { "type": "string", "format": "date-time" },
          "claimed": { "type": "boolean" },
          "payout": { "type": "string", "nullable": true, "example": null }
        }
      },
      "Portfolio": {
        "type": "object",
        "properties": {
          "totalStaked": { "type": "string", "example": "1500000000" },
          "totalWinnings": { "type": "string", "example": "2100000000" },
          "pendingClaims": { "type": "string", "example": "350000000" },
          "activeBets": { "type": "integer", "example": 3 },
          "completedBets": { "type": "integer", "example": 12 },
          "roi": { "type": "number", "example": 40.0 }
        }
      },
      "OracleResult": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "marketId": { "type": "string" },
          "outcome": { "type": "string", "enum": ["FighterA", "FighterB", "Draw", "NoContest"] },
          "source": { "type": "string", "example": "BoxRec" },
          "reportedBy": { "type": "string" },
          "reportedAt": { "type": "string", "format": "date-time" },
          "confirmed": { "type": "boolean" }
        }
      },
      "Oracle": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "address": { "type": "string", "example": "GABC..." },
          "name": { "type": "string", "example": "BoxRec Bot" },
          "active": { "type": "boolean" }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "actionType": { "type": "string" },
          "details": { "type": "object" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaginatedMarkets": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Market" } },
          "page": { "type": "integer" },
          "limit": { "type": "integer" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "address": { "type": "string", "example": "GABC..." },
          "username": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuthChallenge": {
        "type": "object",
        "properties": {
          "challenge": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuthToken": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "SearchResults": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Market" } },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "limit": { "type": "integer" }
        }
      },
      "PlatformStats": {
        "type": "object",
        "properties": {
          "totalMarkets": { "type": "integer", "example": 128 },
          "openMarkets": { "type": "integer", "example": 12 },
          "totalVolume": { "type": "string", "example": "98000000000" },
          "totalBets": { "type": "integer", "example": 5400 },
          "uniqueUsers": { "type": "integer", "example": 2100 }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Returns API and database status.",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "db": { "type": "string", "example": "connected" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Degraded — database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "degraded" },
                    "db": { "type": "string", "example": "disconnected" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/markets": {
      "get": {
        "tags": ["Markets"],
        "summary": "List markets",
        "description": "Returns a paginated list of boxing markets.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["Open", "Locked", "Resolved", "Cancelled", "Disputed"] }
          },
          { "name": "weightClass", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of markets",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedMarkets" }
              }
            }
          }
        }
      }
    },
    "/api/markets/search": {
      "get": {
        "tags": ["Markets", "Search"],
        "summary": "Full-text market search",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Matching markets",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResults" }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "tags": ["Search"],
        "summary": "Search markets and users",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["markets", "users", "all"], "default": "all" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResults" }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["Stats"],
        "summary": "Platform-wide statistics",
        "responses": {
          "200": {
            "description": "Aggregate platform stats",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlatformStats" }
              }
            }
          }
        }
      }
    },
    "/api/auth/challenge": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request a sign-in challenge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["address"],
                "properties": { "address": { "type": "string", "example": "GABC..." } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Challenge issued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthChallenge" }
              }
            }
          },
          "400": {
            "description": "Invalid address",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/auth/verify": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify a signed challenge and issue a JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["address", "signature"],
                "properties": {
                  "address": { "type": "string", "example": "GABC..." },
                  "signature": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthToken" }
              }
            }
          },
          "401": {
            "description": "Invalid signature",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get the authenticated user",
        "security": [{ "UserBearer": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/users/{address}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get a public user profile",
        "parameters": [
          { "name": "address", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/oracle/results": {
      "get": {
        "tags": ["Oracle"],
        "summary": "List reported oracle results",
        "parameters": [
          { "name": "marketId", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Oracle results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/OracleResult" }
                }
              }
            }
          }
        }
      }
    },
    "/api/oracle/submit": {
      "post": {
        "tags": ["Oracle"],
        "summary": "Submit a market result",
        "security": [{ "OracleBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["marketId", "outcome"],
                "properties": {
                  "marketId": { "type": "string" },
                  "outcome": { "type": "string", "enum": ["FighterA", "FighterB", "Draw", "NoContest"] },
                  "source": { "type": "string", "example": "BoxRec" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Result recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OracleResult" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/admin/audit-logs": {
      "get": {
        "tags": ["Admin"],
        "summary": "List audit logs",
        "security": [{ "AdminBearer": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Audit log entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AuditLog" }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  }
}
