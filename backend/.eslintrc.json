{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-console": "error",
    "no-restricted-properties": [
      "error",
      {
        "object": "process",
        "property": "env",
        "message": "Read configuration through the typed config module (import { config } from config.ts) instead of process.env (B-125)."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/__tests__/**/*.ts"
      ],
      "rules": {
        "no-console": "off",
        "no-restricted-properties": "off"
      }
    },
    {
      "files": [
        "src/config.ts",
        "src/config.schema.ts"
      ],
      "rules": {
        "no-restricted-properties": "off"
      }
    }
  ]
}
