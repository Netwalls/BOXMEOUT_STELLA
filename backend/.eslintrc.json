{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-console": "error",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "NewExpression[callee.name='PrismaClient']",
        "message": "Use the shared client exported from src/db.ts instead of creating a PrismaClient (B-129)."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/__tests__/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/db.ts"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ]
}
