// BOXMEOUT — Prisma Schema
// Run: npx prisma migrate dev

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketStatus {
  Open
  Locked
  Resolved
  Cancelled
  Disputed
}

enum Outcome {
  FighterA
  FighterB
  Draw
  NoContest
}

enum BetSide {
  FighterA
  FighterB
}

enum NotificationType {
  MarketResolved
  MarketCancelled
  DisputeRaised
  DisputeResolved
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  iconUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  markets   Market[]

  @@index([deletedAt])
}

model Market {
  id              String       @id
  contractAddress String       @unique
  fighterA        Json
  fighterB        Json
  question        String       @default("")
  description     String       @default("")
  scheduledAt     DateTime
  bettingEndsAt   DateTime
  createdAt       DateTime
  createdBy       String
  status          MarketStatus @default(Open)

  @@index([createdBy])
  @@index([status, scheduledAt])
  outcome         Outcome?
  resolvedAt      DateTime?
  poolA           BigInt       @default(0)
  poolB           BigInt       @default(0)
  totalPool       BigInt       @default(0)
  oracleAddress   String
  txHash          String?
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id])
  bets            Bet[]
  disputes        Dispute[]
  watchedBy       WatchedMarket[]
  oracleResult    OracleResult?
  /// @db.Unsupported("tsvector")
  tsVector        Unsupported("tsvector")?

  @@index([categoryId])
  @@index([tsVector(ops: raw("tsvector_ops"))], type: Gin)
}

model Bet {
  id        String    @id
  marketId  String
  market    Market    @relation(fields: [marketId], references: [id])
  bettor    String
  side      BetSide
  amount    BigInt
  placedAt  DateTime
  claimed   Boolean   @default(false)
  claimedAt DateTime?
  payout    BigInt?
  txHash    String?

  @@index([marketId, bettor])
  @@index([bettor, placedAt])
}

model Dispute {
  id         String    @id @default(uuid())
  marketId   String
  market     Market    @relation(fields: [marketId], references: [id])
  raisedBy   String
  reason     String
  raisedAt   DateTime  @default(now())
  resolvedAt DateTime?
  resolution String?
}

model OracleResult {
  id          String   @id @default(uuid())
  marketId    String   @unique
  market      Market   @relation(fields: [marketId], references: [id])
  reportedBy  String
  outcome     Outcome
  source      String
  reportedAt  DateTime @default(now())
  confirmed   Boolean  @default(false)
}

model IndexerState {
  id          Int      @id @default(1)
  lastLedger  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Oracle {
  id        String   @id @default(uuid())
  address   String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  ipAddress     String
  method        String
  path          String
  requestBody   Json?
  statusCode    Int
  timestamp     DateTime @default(now())

  @@index([timestamp])
}

model User {
  address   String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// B-133 (#1569): one row per bettor per market event, written by the indexer
/// inside the same transaction as the event. `dedupeKey` makes replays idempotent.
model Notification {
  id        String           @id @default(uuid())
  address   String
  type      NotificationType
  marketId  String
  payload   Json
  dedupeKey String           @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([address, createdAt])
}

/// B-134 (#1570): a wallet's watchlist. Deleting a market removes its watch rows.
model WatchedMarket {
  address   String
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([address, marketId])
  @@index([marketId])
}

model EventLog {
  id            Int       @id @default(autoincrement())
  txHash        String
  eventType     String
  contractId    String
  ledger        Int
  ledgerClosedAt DateTime
  body          Json
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([txHash, eventType])
  @@index([processedAt])
}
