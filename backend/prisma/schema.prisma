// BOXMEOUT — Prisma Schema
// Run: npx prisma migrate dev

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketStatus {
  Open
  Locked
  Resolved
  Cancelled
  Disputed
}

enum Outcome {
  FighterA
  FighterB
  Draw
  NoContest
}

enum BetSide {
  FighterA
  FighterB
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  iconUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  markets   Market[]

  @@index([deletedAt])
}

model Market {
  id              String       @id
  contractAddress String       @unique
  fighterA        Json
  fighterB        Json
  question        String       @default("")
  description     String       @default("")
  scheduledAt     DateTime
  bettingEndsAt   DateTime
  createdAt       DateTime
  createdBy       String
  status          MarketStatus @default(Open)

  @@index([createdBy])
  @@index([status, scheduledAt])
  outcome         Outcome?
  resolvedAt      DateTime?
  poolA           BigInt       @default(0)
  poolB           BigInt       @default(0)
  totalPool       BigInt       @default(0)
  oracleAddress   String
  txHash          String?
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id])
  fighterAId      String?
  fighterBId      String?
  fighterAProfile Fighter?     @relation("FighterA", fields: [fighterAId], references: [id])
  fighterBProfile Fighter?     @relation("FighterB", fields: [fighterBId], references: [id])
  bets            Bet[]
  disputes        Dispute[]
  oracleResult    OracleResult?
  oracleReports   OracleReport[]
  /// @db.Unsupported("tsvector")
  tsVector        Unsupported("tsvector")?

  @@index([categoryId])
  @@index([fighterAId])
  @@index([fighterBId])
  @@index([tsVector(ops: raw("tsvector_ops"))], type: Gin)
}

model Fighter {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  record      String   @default("")
  nationality String   @default("")
  weightClass String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  marketsAsA  Market[] @relation("FighterA")
  marketsAsB  Market[] @relation("FighterB")

  @@index([weightClass])
  @@index([name])
}

model Bet {
  id        String    @id
  marketId  String
  market    Market    @relation(fields: [marketId], references: [id])
  bettor    String
  side      BetSide
  amount    BigInt
  placedAt  DateTime
  claimed   Boolean   @default(false)
  claimedAt DateTime?
  payout    BigInt?
  txHash    String?

  @@index([marketId, bettor])
  @@index([bettor, placedAt])
}

model Dispute {
  id         String    @id @default(uuid())
  marketId   String
  market     Market    @relation(fields: [marketId], references: [id])
  raisedBy   String
  reason     String
  raisedAt   DateTime  @default(now())
  resolvedAt DateTime?
  resolution String?
}

model OracleResult {
  id          String   @id @default(uuid())
  marketId    String   @unique
  market      Market   @relation(fields: [marketId], references: [id])
  reportedBy  String
  outcome     Outcome
  source      String
  reportedAt  DateTime @default(now())
  confirmed   Boolean  @default(false)
}

// B-143 (#1579): every individual oracle report. OracleResult stays the single
// decision row per market; OracleReport holds the reports it is decided from.
model OracleReport {
  id         String   @id @default(uuid())
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])
  reportedBy String
  outcome    Outcome
  source     String
  reportedAt DateTime @default(now())

  @@unique([marketId, reportedBy])
  @@index([marketId])
}

model IndexerState {
  id          Int      @id @default(1)
  lastLedger  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Oracle {
  id        String   @id @default(uuid())
  address   String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  ipAddress     String
  method        String
  path          String
  requestBody   Json?
  statusCode    Int
  timestamp     DateTime @default(now())

  @@index([timestamp])
}

model User {
  address   String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventLog {
  id            Int       @id @default(autoincrement())
  txHash        String
  eventType     String
  contractId    String
  ledger        Int
  ledgerClosedAt DateTime
  body          Json
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([txHash, eventType])
  @@index([processedAt])
}
