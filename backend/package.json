{
  "name": "boxmeout-backend",
  "version": "0.1.0",
  "description": "BOXMEOUT backend — indexer + API for the boxing prediction market on Stellar",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:check-drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url $SHADOW_DATABASE_URL --exit-code"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@stellar/stellar-sdk": "^12.0.0",
    "bullmq": "^5.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "ioredis": "^5.0.0",
    "pino": "^8.0.0",
    "pino-http": "^9.0.0",
    "pino-pretty": "^10.0.0",
    "prom-client": "^14.2.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prisma": "^5.0.0",
    "supertest": "^6.0.0",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
