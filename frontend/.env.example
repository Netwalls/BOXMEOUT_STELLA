# BOXMEOUT Frontend — Environment Variables
#
# Copy this file to .env.local and adjust values as needed:
#   cp .env.example .env.local
#
# All NEXT_PUBLIC_* variables are exposed to the browser bundle.
# Never put secrets (private keys, DB credentials) in this file.

# Base URL of the backend REST API. No trailing slash.
# Local backend default: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stellar network to connect to. Use "testnet" for local development
# or "mainnet" for production.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Network passphrase matching NEXT_PUBLIC_STELLAR_NETWORK.
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC endpoint used to build and simulate transactions.
# Testnet default: https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Contract ID of the deployed MarketFactory contract.
# Replace with the ID returned when deploying the contract to your target network.
NEXT_PUBLIC_MARKET_FACTORY_CONTRACT_ID=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Optional ─────────────────────────────────────────────────────────────────

# Comma-separated Stellar addresses with access to the /admin page.
#NEXT_PUBLIC_ADMIN_ADDRESSES=GADMIN1...,GADMIN2...

# Admin key sent with admin requests. Defaults to the connected wallet address.
#NEXT_PUBLIC_ADMIN_API_KEY=

# Set to "true" to build with wallet and chain mocks (used by Playwright e2e tests).
#NEXT_PUBLIC_E2E=false
