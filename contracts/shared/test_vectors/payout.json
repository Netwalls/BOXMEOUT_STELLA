    {
      "name": "standard_split",
      "note": "Two-sided pool; the stake is part of both totals",
      "side": "FighterA",
      "total_pool": "3000",
      "winning_pool": "1500",
      "stake": "500",
      "fee_bp": 200,
      "expected_payout": "980",
      "expected_fee": "60"
    },
    {
      "name": "uneven_split_rounds_down",
      "note": "Payout 1796.67 rounds down to 1796",
      "side": "FighterB",
      "total_pool": "11000",
      "winning_pool": "6000",
      "stake": "1000",
      "fee_bp": 200,
      "expected_payout": "1796",
      "expected_fee": "220"
    },
    {
      "name": "single_stroop_rounds_down",
      "note": "Stake 1 of a 3-stroop winning pool",
      "side": "FighterA",
      "total_pool": "1000003",
      "winning_pool": "3",
      "stake": "1",
      "fee_bp": 200,
      "expected_payout": "326667",
      "expected_fee": "20000"
    },
    {
      "name": "sole_winner_takes_net",
      "note": "Only winners on the winning side: receives the whole net pool",
